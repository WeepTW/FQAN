              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "DataName": {
              "type": "string"
            },
            "Position": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "Begin",
                  "End"
                ],
                "properties": {
                  "Begin": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "integer"
                    }
                  },
                  "End": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "integer"
                    }
                  }
                }
              }
            },
            "Trend": {
              "type": "string"
            },
            "Num": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
