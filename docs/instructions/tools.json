  "checks": [
    {
      "id": "workspace-package-json-valid",
      "cwd": ".",
      "bash": "jq empty package.json",
      "note": "Validate the workspace package index JSON."
    },
    {
      "id": "workspace-tools-json-valid",
      "cwd": ".",
      "bash": "jq empty tools.json",
      "note": "Validate the workspace lookup index JSON."
    },
    {
      "id": "baseline-finder-readme-present",
      "cwd": ".",
      "bash": "test -f ../code/FINDER/README.md",
      "note": "Confirm the primary FINDER baseline mirror exists."
    },
    {
      "id": "baseline-dyrren-present",
      "cwd": ".",
      "bash": "test -d ../code/DyRRen",
      "note": "Confirm the DyRRen reference repo exists."
    },
    {
      "id": "baseline-apollo-present",
      "cwd": ".",
      "bash": "test -d ../code/APOLLO",
      "note": "Confirm the APOLLO reference repo exists."
    },
    {
      "id": "data-finder-finqa-train-csv-present",
      "cwd": ".",
      "bash": "test -f ../code/Data-FINDER/Data_Retriever_Module/finqa_train_rel_fact_instruction_2.csv",
      "note": "Confirm the organized FINDER-style retriever training CSV exists."
    },
    {
      "id": "finflier-reference-output-present",
      "cwd": ".",
      "bash": "test -f ../code/FinFlier/system/Backend/data/output.json",
      "note": "Confirm FinFlier reference sample output exists."
    },
    {
      "id": "finder-mistral-generator-dry-run",
      "targetEnv": "reed",
      "cwd": "../../src",
      "bash": "conda run -n reed python finqa_run.py --dry_run --end 1",
      "note": "Dry-run the active generator entry without claiming a full benchmark execution."
    },
    {
      "id": "finder-mistral-in-context-compile",
      "targetEnv": "reed",
      "cwd": "../../src",
      "bash": "conda run -n reed python -m py_compile In_Context_Selection/learn_policy.py In_Context_Selection/examples_extraction.py",
      "note": "Syntax-check the in-context selection files."
    },
    {
      "id": "finder-mistral-flan-compile",
      "targetEnv": "reed",
      "cwd": "../../src",
      "bash": "conda run -n reed python -m py_compile \"Retriever Codes/Flan/lora_flan_large_finqa_rel_fact.py\"",
      "note": "Syntax-check the FLAN retriever script."
    },
    {
      "id": "finder-mistral-mistral-compile",
      "targetEnv": "reed",
      "cwd": "../../src",
      "bash": "conda run -n reed python -m py_compile \"Retriever Codes/Mistral/mistral_train.py\" \"Retriever Codes/Mistral/mistral_inference.py\"",
      "note": "Syntax-check the Mistral retriever scripts."
    },
    {
      "id": "finder-mistral-experiment-6-7-shell-syntax",
      "targetEnv": "reed",
      "cwd": "../../src",
      "bash": "bash -n dist/experiment_6_retriever.sh dist/experiment_6_no_adapter.sh dist/experiment_6_narratives.sh dist/experiment_6_api_key.sh dist/experiment_6_data_binding_evaluation.sh dist/experiment_7_in_context_selection.sh dist/experiment_7_generator_answer.sh dist/experiment_7_formal_tmux_run.sh dist/generator_no_api_key.sh dist/generator_api_key.sh dist/start_vllm_openai_server.sh dist/generator_runtime_profiles.sh",
      "note": "Syntax-check current Experiment 6/7 shell entrypoints."
    }
  ],
  "runtimeBlockers": [
    "The exact canonical FinQA flan target file best_matched_with_retrieved_facts_and_questions_flan_promptpg.json is missing under src/Data_Target_Module/lora_flan_retriever/output, although nearby variants exist.",
    "The exact canonical Apollo processed test CSV best_matched_with_retrieved_facts_and_questions_apollo_promptpg_processed_data_test.csv is missing under src/Data_Target_Module/Apollo/output, although nearby JSON variants exist.",
    "The deleted active-repo FinFlier copy is not a runtime source; use docs/code/FinFlier/system as read-only reference material.",
    "Official Mistral Small 4 direct loading may exceed local VRAM for unquantized execution; see src/mistral_codegen.py.",
    "Formal Experiment 7 answer computation is blocked until GPT-5.5 selection_cache.json is supplied for the selected dataset/source mode.",
    "Llama3.3 vLLM on this host needs repo-local flash_attn.ops shim and a long ready timeout; the observed first load required about 20.5 minutes.",
    "Experiment 6 controlled metric scaffold can auto-build JSONL from data/src/narratives/narratives1.xlsx, but real model prediction JSONL remains pending."
  ]
